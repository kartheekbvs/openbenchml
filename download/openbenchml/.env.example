# ─── OpenBenchML Environment Configuration ────────────────────────────────────
# Copy this file to .env and update values for your deployment.

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=True
APP_URL=http://localhost:8000
SECRET_KEY=openbenchml-super-secret-key-change-in-production-2024
LOG_LEVEL=INFO

# ─── Authentication ───────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=False
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: leave USE_SQLITE=True and ignore the rest — the app will use
# a local SQLite file (openbenchml.db) so you can develop without a server.
#
# Production: set USE_SQLITE=False and either supply DATABASE_URL directly
# OR set SUPABASE_DB_PASSWORD and the URL will be auto-assembled from the
# Supabase project ref baked into app/config.py.
USE_SQLITE=True
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ─── Supabase ─────────────────────────────────────────────────────────────────
# These values are pre-filled from the OpenBenchML Supabase project
# (project ref: fzwvxesrtdilljgrntpw).  They are safe to commit — the
# anon key is the public key (RLS-protected).  Only SUPABASE_DB_PASSWORD
# is secret and must be set in Render's dashboard.
SUPABASE_PROJECT_REF=fzwvxesrtdilljgrntpw
SUPABASE_URL=https://fzwvxesrtdilljgrntpw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ6d3Z4ZXNydGRpbGxqZ3JudHB3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTA4NzU2NzMsImV4cCI6MjA2NjQ1MTY3M30.YnxjUtFawuumihyVGuk8e-o6iE9OkDf-MX1aKRTqA5U
SUPABASE_DB_PASSWORD=           # ← set this in Render (your Supabase project password)
SUPABASE_POOLER_REGION=aws-0-us-east-1

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Docker Sandbox ──────────────────────────────────────────────────────────
DOCKER_ENABLED=False
DOCKER_TIMEOUT=300

# ─── Benchmark Settings ──────────────────────────────────────────────────────
MAX_MODEL_SIZE_MB=500
BENCHMARK_TIMEOUT_SECONDS=300

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_BENCHMARK=5/minute

# ─── Caching ──────────────────────────────────────────────────────────────────
CACHE_ENABLED=True
CACHE_TTL_LEADERBOARD=60
CACHE_TTL_DATASETS=300
CACHE_TTL_STATS=30

# ─── GZip Compression ────────────────────────────────────────────────────────
GZIP_MIN_SIZE=1000

# ─── WebSocket ───────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100
