+// ─── Files explorer (v2.5) ──────────────────────────────────────────────────
+// VS Code-style file panel: upload, list, download, delete.
+// Files live in /tmp/notebook_files/{user_id}/ on the server, which is also
+// the CWD for cell execution — so anything you upload or `!git clone` is
+// immediately usable in cells via pd.read_csv('file.csv') etc.
+
+let _filesBusy = false;
+
+async function refreshFiles() {
+  if (_filesBusy) return;
+  _filesBusy = true;
+  const list = document.getElementById('files-list');
+  if (!list) return;
+  try {
+    const data = await _fetchJson('/api/notebook/files', {}, 10000);
+    if (data.ok === false && data.__httpStatus === 401) {
+      list.innerHTML = '<div class="empty-state">Authentication required. Refresh the page and log in.</div>';
+      return;
+    }
+    if (!data.ok) {
+      list.innerHTML = '<div class="empty-state">Failed to load files: ' +
+                      escapeHtml(data.stderr || 'Unknown error') + '</div>';
+      return;
+    }
+    // Update quota
+    const quota = document.getElementById('files-quota');
+    if (quota) {
+      quota.textContent = data.total_size_human + ' / ' + data.quota_human + ' used';
+    }
+    const badge = document.getElementById('files-badge');
+    if (badge) {
+      badge.textContent = String(data.count);
+      badge.style.display = data.count > 0 ? 'inline-block' : 'none';
+    }
+    if (!data.files || data.files.length === 0) {
+      list.innerHTML = '<div class="empty-state">' +
+        '<div style="font-size: 2.2rem; margin-bottom: 0.5rem;">&#128193;</div>' +
+        '<div>No files yet. Upload one above, or run ' +
+        '<code style="background: rgba(160,192,0,0.12); padding: 0.1rem 0.4rem; border-radius: 3px;">' +
+        '!git clone https://huggingface.co/zai-org/GLM-5.2</code> in a cell.</div>' +
+        '</div>';
+      return;
+    }
+    list.innerHTML = data.files.map(f => _renderFileRow(f)).join('');
+  } catch (e) {
+    list.innerHTML = '<div class="empty-state">Network error: ' + escapeHtml(e.message) + '</div>';
+  } finally {
+    _filesBusy = false;
+  }
+}
+
+function _renderFileRow(f) {
+  const icon = f.is_dir ? '&#128193;' : _fileIcon(f.name);
+  const childrenHtml = (f.is_dir && f.children && f.children.length > 0) ?
+    '<div class="file-children">' +
+      f.children.map(c => _renderChildRow(c)).join('') +
+    '</div>' : '';
+  return `
+    <div class="file-row ${f.is_dir ? 'is-dir' : ''}" data-path="${escapeHtml(f.path)}">
+      <span class="file-icon">${icon}</span>
+      <span class="file-name" ${f.is_dir ? `onclick="this.parentElement.classList.toggle('expanded')" style="cursor: pointer;"` : ''}>${escapeHtml(f.name)}</span>
+      <span class="file-size">${f.size_human}</span>
+      <span class="file-modified">${_fmtDate(f.modified)}</span>
+      <span class="file-actions">
+        ${!f.is_dir ? `<button class="files-actions-btn" onclick="downloadFile('${escapeHtml(f.path)}')" title="Download">&#8681;</button>` : ''}
+        <button class="files-actions-btn" onclick="insertFileHint('${escapeHtml(f.path)}', ${f.is_dir})" title="Insert code snippet in last cell">&#128203;</button>
+        <button class="files-actions-btn danger" onclick="deleteFile('${escapeHtml(f.path)}')" title="Delete">&#128465;</button>
+      </span>
+      ${childrenHtml}
+    </div>
+  `;
+}
+
+function _renderChildRow(c) {
+  const icon = c.is_dir ? '&#128193;' : _fileIcon(c.name);
+  return `
+    <div class="child-row">
+      <span class="file-icon">${icon}</span>
+      <span class="child-name">${escapeHtml(c.name)}</span>
+      <span class="file-size">${c.size_human}</span>
+      <span class="file-actions">
+        ${!c.is_dir ? `<button class="files-actions-btn" onclick="downloadFile('${escapeHtml(c.path)}')" title="Download">&#8681;</button>` : ''}
+        <button class="files-actions-btn danger" onclick="deleteFile('${escapeHtml(c.path)}')" title="Delete">&#128465;</button>
+      </span>
+    </div>
+  `;
+}
+
+function _fileIcon(name) {
+  const ext = (name.split('.').pop() || '').toLowerCase();
+  if (['csv', 'tsv'].includes(ext)) return '&#128202;';
+  if (['json', 'geojson'].includes(ext)) return '&#128220;';
+  if (['py', 'pyc'].includes(ext)) return '&#128013;';
+  if (['ipynb'].includes(ext)) return '&#128211;';
+  if (['txt', 'md', 'log'].includes(ext)) return '&#128196;';
+  if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext)) return '&#128247;';
+  if (['zip', 'tar', 'gz', 'bz2'].includes(ext)) return '&#128230;';
+  if (['parquet', 'feather', 'pickle'].includes(ext)) return '&#129518;';
+  return '&#128196;';
+}
+
+function _fmtDate(iso) {
+  if (!iso) return '—';
+  try {
+    const d = new Date(iso);
+    return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
+  } catch (e) { return iso.slice(0, 19).replace('T', ' '); }
+}
+
+async function uploadFiles(fileList) {
+  if (!fileList || !fileList.length) return;
+  const list = document.getElementById('files-list');
+  for (const file of fileList) {
+    const formData = new FormData();
+    formData.append('file', file);
+    // Show progress row
+    const progressRow = document.createElement('div');
+    progressRow.className = 'file-row';
+    progressRow.innerHTML = `
+      <span class="file-icon">&#8987;</span>
+      <span class="file-name">Uploading ${escapeHtml(file.name)}…</span>
+      <span class="file-size">${(file.size / 1024).toFixed(1)} KB</span>
+      <span class="file-modified">—</span>
+      <span class="file-actions"></span>
+    `;
+    list.prepend(progressRow);
+    try {
+      const r = await fetch('/api/notebook/files/upload', {
+        method: 'POST',
+        body: formData,
+      });
+      const data = await r.json();
+      if (r.ok && data.ok) {
+        progressRow.innerHTML = `
+          <span class="file-icon" style="color: var(--success-bright);">&#10003;</span>
+          <span class="file-name">Uploaded ${escapeHtml(file.name)} — ${data.size_human}</span>
+          <span class="file-size">${data.size_human}</span>
+          <span class="file-modified">just now</span>
+          <span class="file-actions"></span>
+        `;
+        setTimeout(() => { progressRow.remove(); refreshFiles(); }, 800);
+      } else {
+        progressRow.innerHTML = `
+          <span class="file-icon" style="color: var(--danger-bright);">&#10007;</span>
+          <span class="file-name">Failed: ${escapeHtml(file.name)} — ${escapeHtml(data.detail || 'Unknown error')}</span>
+          <span class="file-size">—</span>
+          <span class="file-modified">—</span>
+          <span class="file-actions"></span>
+        `;
+      }
+    } catch (e) {
+      progressRow.innerHTML = `
+        <span class="file-icon" style="color: var(--danger-bright);">&#10007;</span>
+        <span class="file-name">Network error: ${escapeHtml(e.message)}</span>
+        <span class="file-size">—</span>
+        <span class="file-modified">—</span>
+        <span class="file-actions"></span>
+      `;
+    }
+  }
+  // Reset input so the same file can be re-selected
+  document.getElementById('file-input').value = '';
+}
+
+function downloadFile(path) {
+  // Use a hidden anchor to trigger the download with cookies attached
+  const a = document.createElement('a');
+  a.href = '/api/notebook/files/' + encodeURIComponent(path);
+  a.download = '';
+  a.style.display = 'none';
+  document.body.appendChild(a);
+  a.click();
+  setTimeout(() => a.remove(), 1000);
+}
+
+async function deleteFile(path) {
+  if (!confirm('Delete ' + path + '? This cannot be undone.')) return;
+  try {
+    const r = await fetch('/api/notebook/files/' + encodeURIComponent(path), {
+      method: 'DELETE',
+    });
+    const data = await r.json();
+    if (r.ok && data.ok) {
+      refreshFiles();
+    } else {
+      alert('Delete failed: ' + (data.detail || 'Unknown error'));
+    }
+  } catch (e) {
+    alert('Network error: ' + e.message);
+  }
+}
+
+async function clearAllFiles() {
+  if (!confirm('Delete ALL files in your workspace? This cannot be undone.')) return;
+  try {
+    const r = await fetch('/api/notebook/files/clear', { method: 'POST' });
+    const data = await r.json();
+    if (r.ok && data.ok) {
+      refreshFiles();
+    } else {
+      alert('Clear failed: ' + (data.detail || 'Unknown error'));
+    }
+  } catch (e) {
+    alert('Network error: ' + e.message);
+  }
+}
+
+function insertFileHint(path, isDir) {
+  // Find or create a code cell at the end and insert a hint snippet
+  let lastCell = cells[cells.length - 1];
